---
import '../styles/global.css';
import { translations, type Locale } from '../i18n/translations';

interface Props { locale: Locale }
const { locale } = Astro.props;
const text = translations[locale];
const canonical = new URL(`/${locale}/`, Astro.site);
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={text.description} />
    <meta name="theme-color" content="#f4f8fa" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={new URL('/es/', Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL('/en/', Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL('/es/', Astro.site)} />
    <meta property="og:title" content={text.title} />
    <meta property="og:description" content={text.description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <title>{text.title}</title>
  </head>
  <body>
    <a href="#main" class="skip-link">{text.skip}</a>
    <slot />
  </body>
</html>
