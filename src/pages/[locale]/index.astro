---
import Layout from '../../layouts/Layout.astro';
import LanguageSwitcher from '../../components/LanguageSwitcher.astro';
import ContextComparison from '../../components/ContextComparison';
import { locales, translations, type Locale } from '../../i18n/translations';
import { expertise } from '../../data/expertise';
import { contact, featuredProject, profile } from '../../data/profile';
export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale }, props: { locale } }));
}
interface Props { locale: Locale }
const { locale } = Astro.props;
const text = translations[locale];
const stageIds = ['problem', 'approach', 'result'] as const;
const skillIds = ['languages', 'tools', 'ai'] as const;
---
<Layout locale={locale}>
  <div class="site-shell">
    <header class="site-header">
      <a href={`/${locale}/`} class="wordmark" aria-label={profile.publicName}>az<span aria-hidden="true">/</span></a>
      <nav class="main-navigation" aria-label={text.journey.navigation}>
        <a href="#projects">{text.sections.projects.title}</a>
        <a href="#experience">{text.sections.experience.title}</a>
        <a href="#languages">{text.sections.languages.title}</a>
      </nav>
      <LanguageSwitcher locale={locale} label={text.language} />
    </header>
    <main id="main">
      <section class="introduction" aria-labelledby="introduction-title">
        <div class="identity"><p class="role-label">{text.journey.role}</p><h1 id="introduction-title"><span>Arkaitz</span><span>Zubizarreta</span></h1></div>
        <div class="intro-copy"><p>{text.introduction}</p><div class="intro-links"><a href="#projects" class="primary-link">{text.projectsLink}</a><a href={profile.githubUrl}>{text.githubLink}</a></div></div>
        <div class="progression-intro"><p>{text.journey.statement}</p><ol class="progression-band" aria-label={text.journey.stagesLabel}>
          {stageIds.map((id, index) => (<li><a href={`#stage-${id}`}><span class="stage-index">{String(index + 1).padStart(2, '0')}</span><span>{text.journey.stages[id].short}</span><span aria-hidden="true" class="band-arrow">→</span></a></li>))}
        </ol></div>
      </section>
      <section id="projects" class="project-section" aria-labelledby="projects-title">
        <div class="project-introduction"><p class="section-label">{text.sections.projects.title}</p><h2 id="projects-title">{text.journey.projectHeading}</h2><p>{text.journey.projectSubtitle}</p></div>
        <article aria-labelledby="featured-project-title">
          <div class="project-evidence"><div><p class="section-label">{text.featuredProject.label}</p><h3 id="featured-project-title">{featuredProject.name}</h3><p>{text.featuredProject.description}</p></div><div class="project-resources"><ul class="project-stack">{featuredProject.technologies.map((item) => <li>{item}</li>)}</ul><a class="source-link" href={featuredProject.repositoryUrl}>{text.featuredProject.sourceLink}<span aria-hidden="true">↗</span></a></div></div>
          <div class="story-layout"><ol class="story-stages" aria-label={text.journey.stagesLabel}>
            {stageIds.map((id, index) => (<li id={`stage-${id}`}><span class="stage-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><div><h4>{text.journey.stages[id].title}</h4><p>{text.journey.stages[id].description}</p></div></li>))}
          </ol><ContextComparison text={text.journey.demo} client:load /></div>
        </article>
      </section>
      <div class="background-sections"><section id="about" aria-labelledby="about-title"><h2 id="about-title">{text.sections.about.title}</h2><p>{text.sections.about.description}</p></section><section id="experience" aria-labelledby="experience-title"><h2 id="experience-title">{text.sections.experience.title}</h2><h3>{text.journey.internship}</h3><p>{text.sections.experience.description}</p></section></div>
      <div class="skill-sections">{skillIds.map((id) => (<section id={id} class="skill-section" aria-labelledby={`${id}-title`}><div><h2 id={`${id}-title`}>{text.sections[id].title}</h2><p>{text.sections[id].description}</p></div><ul class="item-list">{expertise[id]?.map((item) => <li>{item}</li>)}</ul></section>))}</div>
      {contact.enabled && contact.url && (<section id="contact" class="contact-section" aria-labelledby="contact-title"><h2 id="contact-title">{text.sections.contact.title}</h2><p>{text.sections.contact.description}</p><a href={contact.url}>{text.contactLink}</a></section>)}
    </main>
    <footer class="site-footer"><p>{profile.publicName}</p><p>{text.footer}</p><a href="https://github.com/Zubiarka8/zubiarka8.github.io">GitHub</a></footer>
  </div>
</Layout>
