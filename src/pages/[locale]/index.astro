---
import Layout from '../../layouts/Layout.astro';
import LanguageSwitcher from '../../components/LanguageSwitcher';
import RelationshipExplorer from '../../components/RelationshipExplorer.astro';
import { locales, translations, type Locale } from '../../i18n/translations';
import { expertise } from '../../data/expertise';
import { profile } from '../../data/profile';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale }, props: { locale } }));
}
interface Props { locale: Locale }
const { locale } = Astro.props;
const text = translations[locale];
const skillSections = ['languages', 'tools', 'ai'] as const;
---
<Layout locale={locale}>
  <div class="site-shell">
    <header class="site-header">
      <a href={`/${locale}/`} class="wordmark" aria-label={profile.publicName}>az<span aria-hidden="true">⋆</span></a>
      <nav class="main-navigation" aria-label={text.connections.navigation}>
        <a href="#projects">{text.sections.projects.title}</a>
        <a href="#experience">{text.sections.experience.title}</a>
        <a href="#languages">{text.sections.languages.title}</a>
      </nav>
      <LanguageSwitcher locale={locale} label={text.language} client:load />
    </header>
    <main id="main">
      <section class="introduction" aria-labelledby="introduction-title">
        <div class="name-block">
          <h1 id="introduction-title"><span>Arkaitz</span><span>Zubizarreta<span class="name-dot" aria-hidden="true">.</span></span></h1>
          <p class="personal-statement">{text.connections.statement}</p>
        </div>
        <div class="introduction-copy">
          <p>{text.introduction}</p>
          <div class="intro-links">
            <a href="#projects" class="primary-link">{text.projectsLink}<span aria-hidden="true">↓</span></a>
            <a href={profile.githubUrl} class="quiet-link">{text.githubLink}<span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </section>
      <RelationshipExplorer locale={locale} />
      <div class="background-sections">
        <section id="about" aria-labelledby="about-title">
          <h2 id="about-title">{text.sections.about.title}</h2>
          <p>{text.sections.about.description}</p>
        </section>
        <section id="experience" class="experience-section" aria-labelledby="experience-title">
          <h2 id="experience-title">{text.sections.experience.title}</h2>
          <h3>{text.connections.internship}</h3>
          <p>{text.sections.experience.description}</p>
        </section>
      </div>
      <div class="skill-sections">
        {skillSections.map((id) => (
          <section id={id} class="skill-section" aria-labelledby={`${id}-title`}>
            <div><h2 id={`${id}-title`}>{text.sections[id].title}</h2><p>{text.sections[id].description}</p></div>
            <ul class="item-list">{expertise[id]?.map((item) => <li>{item}</li>)}</ul>
          </section>
        ))}
      </div>
    </main>
    <footer class="site-footer">
      <p>{profile.publicName}</p><p>{text.footer}</p>
      <a href="https://github.com/Zubiarka8/zubiarka8.github.io">GitHub <span aria-hidden="true">↗</span></a>
    </footer>
  </div>
</Layout>
